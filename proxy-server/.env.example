# =========================================
# GPTini 프록시 서버 환경변수 설정
# .env.example을 복사해서 .env 파일로 사용하세요
# cp .env.example .env
# =========================================

# [필수] Spring 백엔드 서버 주소
# 레포 코드 확인 후 실제 주소/포트로 변경
TARGET_URL=http://your-spring-server.com:8080

# [선택] 프록시 서버 포트 (Render/Railway는 자동 설정)
PORT=3000

# [선택] Spring REST API 기본 경로 (레포 확인 후 수정)
API_PATH=/api

# [선택] Spring WebSocket 엔드포인트 경로 (레포 확인 후 수정)
# Spring STOMP 사용 시 보통 /ws 또는 /chat
WS_PATH=/ws

# [선택] 허용할 클라이언트 출처 (쉼표 구분, * 는 모두 허용)
# 예: https://your-react-app.vercel.app,vscode-webview://*
ALLOWED_ORIGINS=*
