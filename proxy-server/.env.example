# =========================================
# GPTini 프록시 서버 환경변수 설정
# .env.example을 복사해서 .env 파일로 사용하세요
# cp .env.example .env
# =========================================

# [필수] Spring 백엔드 서버 주소
# SSL 설정 전 (EC2 직접): http://3.37.92.94:8080
# SSL 설정 후 (도메인):   https://api.gptini.org
TARGET_URL=http://3.37.92.94:8080

# [선택] 프록시 서버 포트 (Render/Railway는 자동 설정)
PORT=3000

# [선택] Spring REST API 기본 경로
# → 백엔드 레포 @RequestMapping 확인 후 수정
API_PATH=/api

# [선택] Spring WebSocket 엔드포인트 경로
# → 백엔드 레포 WebSocketConfig 확인 후 수정 (/ws 또는 /chat 등)
WS_PATH=/ws

# [선택] 허용할 클라이언트 출처 (쉼표 구분, * 는 모두 허용)
# React 앱이 CloudFront에 있으므로: https://dc8adsogldz1a.cloudfront.net
# VSCode 웹뷰도 허용: vscode-webview://*
ALLOWED_ORIGINS=*
