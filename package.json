{
  "name": "gptini",
  "displayName": "GPTini",
  "description": "Simple chat extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chat-sidebar",
          "title": "Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "chat-sidebar": [
        {
          "type": "webview",
          "id": "chat-view",
          "name": "Messages"
        }
      ]
    },
    "configuration": {
      "title": "GPTini",
      "properties": {
        "gptini.serverUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "GPTini 백엔드 서버 URL"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "mocha": "^10.1.0",
    "typescript": "^5.3.0",
    "@vscode/test-electron": "^2.2.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "axios": "^1.6.0"
  }
}